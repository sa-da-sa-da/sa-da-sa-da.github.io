{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- /* 全站模板改版会影响所有页面的 title/description，但内容 md 的 git 时间没变。
       用站点级发布日做 lastmod 下限，避免 Bing 因 lastmod 太旧而不重抓。 */ -}}
{{- $release := time (site.Data.site_release.seo_release) -}}
{{- range .Pages }}
{{- if .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- $lm := .Lastmod -}}
    {{- if or $lm.IsZero ($lm.Before $release) }}{{ $lm = $release }}{{ end }}
    <lastmod>{{ safeHTML ($lm.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
  </url>
{{- end }}
{{- end }}
{{- /* static/ 下的手写页不在 Hugo 页面集合里，靠 data/static-pages.yaml 补进站点地图，
       否则搜索引擎只能通过内链发现（tool 页收录很慢）。 */}}
{{- range site.Data.static_pages }}
{{- $file := .file }}
{{- $priority := .priority | default 0.6 }}
{{- $url := printf "/%s" $file }}
{{- if strings.HasSuffix $file "index.html" }}
  {{- $url = printf "/%s" (strings.TrimSuffix "index.html" $file) }}
{{- end }}
{{- with os.Stat (printf "static/%s" $file) }}
  <url>
    <loc>{{ $url | absURL }}</loc>
    <lastmod>{{ .ModTime.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{{ $priority }}</priority>
  </url>
{{- end }}
{{- end }}
</urlset>
